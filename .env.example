# .env  — copy this to .env and fill in your values
# Used by docker-compose and all Python services via python-dotenv

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_SERVICE_USERNAME=service_account
MQTT_SERVICE_PASSWORD=change-me
MQTT_USE_TLS=false
MQTT_TLS_CA_CERT=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=museum_tour
POSTGRES_USER=museum
POSTGRES_PASSWORD=change-me

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
VISION_MODEL=claude-opus-4-5
# Model used for server-side audio transcription (Gemini only). Defaults to LLM_MODEL.
STT_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ── Embedding model (local, no API key needed) ────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
